@model List<SandiqMVC.Models.Order>
@{
    ViewData["Title"] = "Sifarişlərim";
}

<div class="checkout-page">
    <h2 class="checkout-page__title">Sifarişlərim</h2>

    @if (!Model.Any())
    {
        <p>Hələ sifarişiniz yoxdur.</p>
    }

    @foreach (var order in Model)
    {
        var statusLabel = order.Status switch
        {
            "confirmed" => "Ödəniş təsdiqləndi",
            "cancelled" => "Ləğv edildi",
            _ => "Ödəniş yoxlanılır"
        };
        var statusClass = order.Status switch
        {
            "confirmed" => "status--approved",
            "cancelled" => "status--rejected",
            _ => "status--pending"
        };

        <div class="checkout-card" style="margin-bottom:16px;">
            <div style="display:flex;justify-content:space-between;align-items:center;">
                <strong>Sifariş #@order.Id</strong>
                <span class="status-badge @statusClass">@statusLabel</span>
            </div>
            <p class="checkout-hint">@order.CreatedAt.AddHours(4).ToString("dd.MM.yyyy HH:mm")</p>
            <div class="checkout-items">
                @foreach (var item in order.Items)
                {
                    <div class="checkout-item">
                        <span class="checkout-item__title">@item.Title <span class="checkout-item__qty">× @item.Quantity</span></span>
                        <span>@((item.UnitPrice * item.Quantity).ToString("N2")) ₼</span>
                    </div>
                }
                <div class="checkout-summary-row">
                    <span>Cəmi</span>
                    <strong>@order.TotalAmount.ToString("N2") ₼</strong>
                </div>
            </div>
        </div>
    }
</div>
