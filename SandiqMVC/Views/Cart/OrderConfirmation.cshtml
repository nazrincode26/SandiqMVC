@model SandiqMVC.Models.Order
@{
    ViewData["Title"] = "Sifariş qeydə alındı";
    var statusLabel = Model.Status switch
    {
        "confirmed" => "Ödəniş təsdiqləndi",
        "cancelled" => "Ləğv edildi",
        _ => "Ödəniş yoxlanılır"
    };
    var statusClass = Model.Status switch
    {
        "confirmed" => "status--approved",
        "cancelled" => "status--rejected",
        _ => "status--pending"
    };
}

<div class="checkout-page">
    <partial name="_CheckoutSteps" model="3" />

    <div class="checkout-card checkout-confirmation">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.6"><circle cx="12" cy="12" r="10"></circle><path d="M8 12l3 3 5-6"></path></svg>
        <h2>Sifarişiniz qəbul edildi</h2>
        <p class="checkout-hint">Sifariş nömrəniz: <strong>#@Model.Id</strong></p>
        <span class="status-badge @statusClass">@statusLabel</span>

        <div class="checkout-items" style="margin-top:20px;">
            @foreach (var item in Model.Items)
            {
                <div class="checkout-item">
                    <span class="checkout-item__title">@item.Title <span class="checkout-item__qty">× @item.Quantity</span></span>
                    <span>@((item.UnitPrice * item.Quantity).ToString("N2")) ₼</span>
                </div>
            }
            <div class="checkout-summary-row">
                <span>Cəmi</span>
                <strong>@Model.TotalAmount.ToString("N2") ₼</strong>
            </div>
        </div>

        <p class="checkout-security-note" style="margin-top:16px;">Admin köçürməni təsdiqlədikdən sonra satıcı ilə əlaqə saxlanılacaq. Statusu <a asp-action="MyOrders">Sifarişlərim</a> səhifəsindən izləyə bilərsiniz.</p>

        <a asp-controller="Home" asp-action="Index" class="checkout-place-btn" style="display:inline-block;text-decoration:none;text-align:center;">Ana səhifəyə qayıt</a>
    </div>
</div>
