@model int
@{
    var steps = new[] { "Sifarişi yoxla", "Ödəniş et", "Təsdiq" };
}

<div class="checkout-steps">
    @for (var i = 0; i < steps.Length; i++)
    {
        var stepNum = i + 1;
        var cssClass = stepNum == Model ? "checkout-step--active" : (stepNum < Model ? "checkout-step--done" : "");
        <div class="checkout-step @cssClass" data-step="@stepNum">
            <span class="checkout-step__num">@(stepNum < Model ? "✓" : stepNum.ToString())</span>
            <span>@steps[i]</span>
        </div>
    }
</div>
