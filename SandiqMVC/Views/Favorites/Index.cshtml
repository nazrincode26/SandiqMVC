@{
    ViewData["Title"] = "Favorilərim";
}

<h2 data-i18n="favorites_title">Favorilərim</h2>
<div id="favoritesGrid" class="product-grid"></div>

@section Scripts {
    <script type="module">
        import { t } from "/assets/js/i18n-utils.js";

        function renderFavoritesPage() {
            const gridEl = document.getElementById("favoritesGrid");
            const items = getFavorites();

            if (items.length === 0) {
                gridEl.innerHTML = `<p>${t("favorites_empty")}</p>`;
                return;
            }

            gridEl.innerHTML = items
                .map(
                    (item) => `
                  <div class="product-card" data-id="${item.productId}">
                    <div class="product-card__image">
                      <div style="width:100%;height:100%;background:#EFE6D6;"></div>
                    </div>
                    <div class="product-card__body">
                      <h3 class="product-card__title">${item.title}</h3>
                      <p class="product-card__price">${formatPrice(item.price)}</p>
                      <button class="cart-btn">${t("add_to_cart")}</button>
                      <button class="remove-btn">${t("remove_from_favorites")}</button>
                    </div>
                  </div>
                `
                )
                .join("");

            gridEl.querySelectorAll(".cart-btn").forEach((btn) => {
                btn.addEventListener("click", (e) => {
                    const id = Number(e.target.closest(".product-card").dataset.id);
                    const item = getFavorites().find((f) => f.productId === id);
                    addToCart({ id: item.productId, title: item.title, price: item.price, image: item.image });
                    updateHeaderBadges();
                    showToast(t("cart_added_alert"));
                });
            });

            gridEl.querySelectorAll(".remove-btn").forEach((btn) => {
                btn.addEventListener("click", (e) => {
                    const id = Number(e.target.closest(".product-card").dataset.id);
                    removeFromFavorites(id);
                    updateHeaderBadges();
                    renderFavoritesPage();
                });
            });
        }

        document.addEventListener("DOMContentLoaded", renderFavoritesPage);
    </script>
}