@using System.Security.Claims
@model SandiqMVC.Models.Product
@{
    var isOwnListing = User.Identity?.IsAuthenticated == true
        && int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!) == Model.SubmittedByUserId;
}

<div class="product-card" data-id="@Model.Id" data-title="@Model.Title" data-price="@Model.Price" data-image="@Model.Image">
    <div class="product-card__image">
        <a href="/Product/Details/@Model.Id" style="display:block;width:100%;height:100%;">
            @if (!string.IsNullOrEmpty(Model.Image))
            {
                <img src="@Model.Image" alt="@Model.Title" style="width:100%;height:100%;object-fit:cover;" />
            }
            else
            {
                <div style="width:100%;height:100%;background:#EFE6D6;"></div>
            }
        </a>
        <button type="button" class="product-card__favorite js-favorite-btn" aria-label="Favorilərə əlavə et">♥</button>
    </div>
    <div class="product-card__body">
        <a href="/Product/Details/@Model.Id" style="text-decoration:none;color:inherit;">
            <h3 class="product-card__title">@Model.Title</h3>
            <p class="product-card__price">@Model.Price.ToString("N0") ₼</p>
        </a>
        @if (isOwnListing)
        {
            <button type="button" class="product-card__cart-btn" disabled title="Öz elanınızı ala bilməzsiniz">Öz elanınızdır</button>
        }
        else
        {
            <button type="button" class="product-card__cart-btn js-cart-btn" data-i18n="add_to_cart">Səbətə at</button>
        }
    </div>
</div>