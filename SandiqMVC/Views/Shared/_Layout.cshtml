<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sandıq</title>
    <link rel="icon" type="image/png" href="~/assets/images/logo.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/css/style.css" />
    <link rel="stylesheet" href="~/assets/css/header.css" />
    <link rel="stylesheet" href="~/assets/css/product-card.css" />
    <link rel="stylesheet" href="~/assets/css/chatbot.css" />
</head>
<body>
    <header>
        <div class="header__container">
            <button id="menuBtn" class="menu-btn" aria-label="Menyu">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>
            <div class="lang-selector">
                <button id="langBtn" class="lang-btn" type="button">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                    <span id="currentLangLabel">AZ</span>
                </button>
                <div id="langDropdown" class="lang-dropdown">
                    <button class="lang-option" type="button" data-lang="az">Azərbaycan dili</button>
                    <button class="lang-option" type="button" data-lang="ru">Русский</button>
                    <button class="lang-option" type="button" data-lang="en">English</button>
                </div>
            </div>
            <a href="/" class="header__logo">
                <img src="~/assets/images/logo.png" alt="Sandıq" />
            </a>

            <button id="catalogBtn" class="catalog-btn" type="button">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                    <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                    <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                    <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                </svg>
                <span data-i18n="catalog">Kataloq</span>
            </button>

            <form class="header__search" asp-controller="Category" asp-action="Search" method="get">
                <input type="text" name="q" data-i18n-placeholder="search_placeholder" placeholder="Axtar..." autocomplete="off" />
                <button type="submit" aria-label="Axtar">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </button>
            </form>

            <nav class="header__nav">
                <div class="header__nav-icons">
                    <a href="/Favorites" class="header__icon-link">
                        ♥ <span class="badge" id="favBadge">0</span>
                    </a>
                    <a href="/Cart" class="header__icon-link">
                        🛒 <span class="badge" id="cartBadge">0</span>
                    </a>
                </div>
                <div class="header__nav-actions">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-area="Admin" asp-controller="Categories" asp-action="Index">Admin: Kateqoriyalar</a>
                            <a asp-area="Admin" asp-controller="Listings" asp-action="Index">Admin: Elanlar</a>
                        }
                        <div class="header__user-menu">
                            <button id="userMenuBtn" class="header__user-btn" type="button">
                                @User.Identity.Name
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                            </button>
                            <div id="userDropdown" class="user-dropdown">
                                <a asp-controller="Listings" asp-action="MyListings" class="user-dropdown__item" data-i18n="my_listings">Mənim elanlarım</a>
                                <a asp-controller="Account" asp-action="Settings" class="user-dropdown__item" data-i18n="settings">Parametrlər</a>
                                <div class="user-dropdown__divider"></div>
                                <a asp-controller="Account" asp-action="Logout" class="user-dropdown__item user-dropdown__item--danger" data-i18n="logout">Çıxış</a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" data-i18n="login">Giriş</a>
                        <a asp-controller="Account" asp-action="Register" data-i18n="register">Qeydiyyat</a>
                    }
                    <a asp-controller="Listings" asp-action="Create" class="post-ad-btn post-ad-btn--filled">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        <span data-i18n="post_ad">Elan yerləşdir</span>
                    </a>
                </div>
            </nav>
        </div>

        <div id="megaMenu" class="mega-menu">
            @await Component.InvokeAsync("CategoryMenu")
        </div>

        <div id="sideMenuOverlay" class="side-menu-overlay"></div>
        <aside id="sideMenu" class="side-menu">
            <a href="/" class="side-menu__item" data-i18n="home_page">Ana səhifə</a>

            <div class="side-menu__item side-menu__item--has-submenu">
                <span data-i18n="legal_info">Hüquqi məlumat</span>
                <span class="side-menu__arrow">›</span>
                <div class="side-menu__submenu">
                    <a asp-controller="Info" asp-action="Legal" asp-fragment="user-agreement" data-i18n="legal_agreement_title">İstifadəçi razılaşması</a>
                    <a asp-controller="Info" asp-action="Legal" asp-fragment="privacy-policy" data-i18n="legal_privacy_title">Məxfilik siyasəti</a>
                    <a asp-controller="Info" asp-action="Legal" asp-fragment="offer-agreement" data-i18n="legal_offer_title">Oferta müqaviləsi</a>
                    <a asp-controller="Info" asp-action="Legal" asp-fragment="ad-posting-terms" data-i18n="legal_adterms_title">Elan paylaşma şərtləri</a>
                </div>
            </div>

            <div class="side-menu__item side-menu__item--has-submenu">
                <span data-i18n="site_rules">Sandıq qaydaları</span>
                <span class="side-menu__arrow">›</span>
                <div class="side-menu__submenu">
                    <a asp-controller="Info" asp-action="Rules" asp-fragment="safe-trade" data-i18n="rules_safety_title">Təhlükəsiz sat və al</a>
                    <a asp-controller="Info" asp-action="Rules" asp-fragment="how-to-sell" data-i18n="rules_howto_title">Necə satmaq lazımdır</a>
                    <a asp-controller="Info" asp-action="Rules" asp-fragment="promotion-rules" data-i18n="rules_promo_title">Aksiyanın qaydaları</a>
                </div>
            </div>

            <a asp-controller="Info" asp-action="About" class="side-menu__item" data-i18n="about_us">Bizim haqqımızda</a>
            <a asp-controller="Info" asp-action="Contact" class="side-menu__item" data-i18n="contact">Əlaqə</a>

            <div class="side-menu__divider"></div>

            <div class="side-menu__social">
                <a href="#" class="side-menu__social-link">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="2" width="20" height="20" rx="5"></rect>
                        <circle cx="12" cy="12" r="4"></circle>
                        <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"></circle>
                    </svg>
                    Instagram
                </a>
            </div>

            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-controller="Account" asp-action="Login" class="side-menu__item" data-i18n="login">Giriş</a>
                <a asp-controller="Account" asp-action="Register" class="side-menu__item" data-i18n="register">Qeydiyyat</a>
            }
        </aside>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <div class="footer__container">
            <div class="footer__brand">
                <img src="~/assets/images/logo.png" alt="Sandıq" />
                <div>
                    <h3>Sandıq</h3>
                    <p data-i18n="footer_tagline">Hər şey bir sandıqda</p>
                </div>
            </div>

            <div class="footer__links">
                <h4 data-i18n="footer_quick_links">Tez keçidlər</h4>
                <a href="/" data-i18n="home_page">Ana səhifə</a>
                <a asp-controller="Info" asp-action="About" data-i18n="about_us">Bizim haqqımızda</a>
                <a asp-controller="Info" asp-action="Rules" data-i18n="site_rules">Sandıq qaydaları</a>
                <a asp-controller="Info" asp-action="Contact" data-i18n="contact">Əlaqə</a>
            </div>

            <div class="footer__social">
                <h4 data-i18n="footer_social">Bizi izləyin</h4>
                <a href="#" class="footer__social-link">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="2" width="20" height="20" rx="5"></rect>
                        <circle cx="12" cy="12" r="4"></circle>
                        <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"></circle>
                    </svg>
                    Instagram
                </a>
            </div>
        </div>

        <div class="footer__bottom">
            <p>&copy; @DateTime.Now.Year Sandıq. <span data-i18n="footer_copyright">Bütün hüquqlar qorunur</span></p>
        </div>
    </footer>

    <div id="chatbotWidget" class="chatbot-widget">
        <button id="chatbotToggle" class="chatbot-toggle" type="button" aria-label="Kömək">💬</button>
        <div id="chatbotPanel" class="chatbot-panel hidden">
            <div class="chatbot-panel__header">
                <span id="chatbotTitle">Kömək</span>
                <button id="chatbotClose" class="chatbot-panel__close" type="button" aria-label="Bağla">×</button>
            </div>
            <div id="chatbotBody" class="chatbot-panel__body"></div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/cart.js" asp-append-version="true"></script>
    <script src="~/assets/js/favorites.js" asp-append-version="true"></script>
    <script src="~/assets/js/format-price.js" asp-append-version="true"></script>
    <script src="~/assets/js/toast.js" asp-append-version="true"></script>
    <script src="~/assets/js/product-actions.js" asp-append-version="true"></script>
    <script src="~/assets/js/sandiq-ui.js" asp-append-version="true"></script>
    <script src="~/assets/js/chatbot.js" type="module" asp-append-version="true"></script>
    <script type="module">
            import { getLang, setLang, applyTranslations } from "/assets/js/i18n-utils.js";

            document.getElementById("currentLangLabel").textContent = getLang().toUpperCase();

            document.querySelectorAll(".lang-option").forEach((btn) => {
                btn.addEventListener("click", () => {
                    setLang(btn.dataset.lang);
                });
            });

            applyTranslations();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>