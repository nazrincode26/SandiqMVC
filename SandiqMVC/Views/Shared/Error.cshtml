@model ErrorViewModel
@{
    ViewData["Title"] = "Xəta baş verdi";
}

<div class="not-found">
    <h1>⚠️</h1>
    <h2 data-i18n="error_title">Xəta baş verdi</h2>
    <p data-i18n="error_text">Gözlənilməz bir xəta baş verdi. Zəhmət olmasa bir az sonra yenidən cəhd edin.</p>
    @if (Model.ShowRequestId)
    {
        <p class="not-found__request-id">Request ID: <code>@Model.RequestId</code></p>
    }
    <a href="/" class="post-ad-btn post-ad-btn--filled" data-i18n="go_home_button">Ana səhifəyə qayıt</a>
</div>