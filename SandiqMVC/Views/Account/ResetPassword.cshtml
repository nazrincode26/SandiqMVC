@model SandiqMVC.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Şifrəni sıfırla";
}

<main class="auth-page">
    <h2 data-i18n="reset_title">Şifrəni sıfırla</h2>

    @if (ViewBag.Success == true)
    {
        <p style="color: green;" data-i18n="reset_success">Şifrən dəyişdirildi. İndi yeni şifrənlə daxil ola bilərsən.</p>
        <p><a asp-action="Login" data-i18n="login_link">Daxil ol</a></p>
    }
    else
    {
        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input asp-for="Email" data-i18n-placeholder="email_placeholder" placeholder="E-poçt" />
            <input asp-for="Code" data-i18n-placeholder="code_placeholder" placeholder="Email-ə gələn 6 rəqəmli kod" />
            <input asp-for="NewPassword" type="password" data-i18n-placeholder="new_password_placeholder" placeholder="Yeni şifrə" />
            <button type="submit" data-i18n="reset_button">Şifrəni dəyiş</button>
        </form>
    }
</main>
