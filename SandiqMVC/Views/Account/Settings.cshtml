@model SandiqMVC.ViewModels.SettingsViewModel

@{
    ViewData["Title"] = "Parametrlər";
}

<form asp-action="Settings" method="post" class="settings-form">
    <h2 data-i18n="settings_title">Parametrlər</h2>
    <p data-i18n="settings_subtitle">Profil məlumatlarını buradan yeniləyə bilərsən</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="text-danger"></div>
    }

    @if (ViewBag.Success == true)
    {
        <p style="color: green;" data-i18n="settings_saved_success">Məlumatlar yadda saxlanıldı.</p>
    }

    <label>
        <span data-i18n="name_label">Ad Soyad</span>
        <input asp-for="FullName" />
    </label>

    <label>
        <span data-i18n="email_label">E-poçt</span>
        <input asp-for="Email" />
    </label>

    <label>
        <span data-i18n="phone_label">Telefon</span>
        <input asp-for="Phone" placeholder="+994 XX XXX XX XX" />
    </label>

    <button type="submit" data-i18n="save_button">Yadda saxla</button>
</form>