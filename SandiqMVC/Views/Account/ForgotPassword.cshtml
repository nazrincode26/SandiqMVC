@model SandiqMVC.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Şifrəni unutdum";
}

<main class="auth-page">
    <h2 data-i18n="forgot_title">Şifrəni unutdum</h2>
    <p data-i18n="forgot_subtitle">Qeydiyyatdan keçdiyin email-i yaz, sənə sıfırlama kodu göndərək.</p>

    @if (ViewBag.Success == true)
    {
        <p style="color: green;" data-i18n="forgot_success">Əgər bu email qeydiyyatdan keçibsə, sıfırlama kodu göndərildi. E-poçtunu yoxla.</p>
    }
    else
    {
        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input asp-for="Email" data-i18n-placeholder="email_placeholder" placeholder="E-poçt" />
            <span asp-validation-for="Email" class="text-danger field-validation-error"></span>
            <button type="submit" data-i18n="send_code_button">Kod göndər</button>
        </form>
    }
    <p><span data-i18n="got_code">Kodu aldın?</span> <a asp-action="ResetPassword" data-i18n="reset_link">Şifrəni sıfırla</a></p>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}