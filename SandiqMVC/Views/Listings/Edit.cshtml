@model SandiqMVC.ViewModels.EditListingViewModel

@{
    ViewData["Title"] = "Elanı redaktə et";
}

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="post-ad-form" id="postAdForm">
    <input type="hidden" asp-for="Id" />
    <div class="post-ad-form__header">
        <div>
            <h2 data-i18n="edit_ad_title">Elanı redaktə et</h2>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="text-danger"></div>
    }

    <section class="post-ad-section">
        <h3 class="post-ad-section__title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
            <span data-i18n="basic_info">Əsas məlumat</span>
        </h3>
        <label>
            <span data-i18n="title_label">Başlıq</span>
            <input asp-for="Title" id="adTitle" list="titleKeywords" autocomplete="off" />
            <partial name="_TitleKeywordsDatalist" />
            <span asp-validation-for="Title" class="text-danger"></span>
            <span class="post-ad-section__hint" id="titleError" style="color:var(--color-danger);display:none;">Yalnız siyahıdan bir söz seçin.</span>
        </label>
        <label>
            <span data-i18n="description_label">Təsvir</span>
            <textarea asp-for="Description" rows="5"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </label>
    </section>

    <section class="post-ad-section">
        <h3 class="post-ad-section__title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect></svg>
            <span data-i18n="category_price_section">Kateqoriya və qiymət</span>
        </h3>
        <div class="post-ad-form__grid">
            <label>
                <span data-i18n="category_label">Kateqoriya</span>
                <select asp-for="CategoryId" id="adCategory">
                    <option value="" data-i18n="select_option">Seçin...</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id" data-name-az="@category.Name" data-name-ru="@(category.NameRu ?? category.Name)" data-name-en="@(category.NameEn ?? category.Name)">@category.Name</option>
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </label>
            <label>
                <span data-i18n="subcategory_label">Alt kateqoriya</span>
                <select asp-for="SubcategoryId" id="adSubcategory">
                    <option value="" data-i18n="select_category_first">Əvvəlcə kateqoriya seçin</option>
                </select>
            </label>
            <label>
                <span data-i18n="price_label">Qiymət (₼)</span>
                <input asp-for="Price" id="adPrice" type="text" inputmode="decimal" oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1')" />
                <span asp-validation-for="Price" class="text-danger"></span>
                <span class="post-ad-section__hint" id="priceFeeNote"></span>
            </label>
            <label>
                <span data-i18n="condition_label">Vəziyyəti</span>
                <select asp-for="Condition">
                    <option value="new" data-i18n="condition_new">Yeni</option>
                    <option value="used" data-i18n="condition_used">İşlənmiş</option>
                </select>
            </label>
            <label class="post-ad-form__full">
                <span data-i18n="location_label">Yerləşdiyi yer</span>
                <input asp-for="Location" list="azRegions" autocomplete="off" />
                <partial name="_AzRegionsDatalist" />
            </label>
        </div>
    </section>

    <section class="post-ad-section">
        <h3 class="post-ad-section__title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg>
            <span data-i18n="images_label">Şəkillər</span>
            <span class="post-ad-section__hint">(maksimum @SandiqMVC.Models.Product.MaxImages ədəd)</span>
        </h3>
        @if (Model.ExistingImages.Any())
        {
            <p class="post-ad-section__hint">Hazırkı şəkillər (yeni şəkil yükləsəniz, admin təsdiqindən sonra bunların yerinə keçəcək):</p>
            <div class="post-ad-previews">
                @foreach (var img in Model.ExistingImages)
                {
                    <div class="post-ad-preview">
                        <img src="@img" alt="@Model.Title" />
                    </div>
                }
            </div>
        }
        <div class="post-ad-dropzone" id="dropzone">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
            <p><span data-i18n="drag_drop_text">Şəkilləri bura sürüşdürün və ya</span> <span class="post-ad-dropzone__link" data-i18n="click_to_select">seçmək üçün klikləyin</span></p>
            <input asp-for="ImageFiles" id="adImages" accept="image/*" multiple hidden />
        </div>
        <div class="post-ad-previews" id="imagePreviews"></div>
    </section>

    <button type="submit" data-i18n="save_button">Yadda saxla</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module">
        import { t, getLang } from "/assets/js/i18n-utils.js";

        const categoriesData = @Json.Serialize(Model.Categories.Select(c => new { id = c.Id, name = c.Name, nameRu = c.NameRu ?? c.Name, nameEn = c.NameEn ?? c.Name, subcategories = c.Subcategories.Select(s => new { id = s.Id, name = s.Name, nameRu = s.NameRu ?? s.Name, nameEn = s.NameEn ?? s.Name }) }));
        const selectedSubcategoryId = @Json.Serialize(Model.SubcategoryId);

        function localName(item) {
        const lang = getLang();
        if (lang === "ru") return item.nameRu;
        if (lang === "en") return item.nameEn;
        return item.name;
        }

        const PLATFORM_FEE_RATE = @Html.Raw(SandiqMVC.Models.Order.PlatformFeeRate.ToString(System.Globalization.CultureInfo.InvariantCulture));
        const priceInput = document.getElementById("adPrice");
        const priceFeeNote = document.getElementById("priceFeeNote");

        function updatePriceFeeNote() {
        const price = parseFloat(priceInput.value);
        if (!price || price <= 0) {
        priceFeeNote.textContent = "";
        return;
        }
        const fee = Math.round(price * PLATFORM_FEE_RATE * 100) / 100;
        const netAmount = Math.round((price - fee) * 100) / 100;
        priceFeeNote.textContent = `Bu qiymətdən sizə çatacaq: ${netAmount} ₼ · Platform xidmət haqqı (${PLATFORM_FEE_RATE * 100}%): ${fee} ₼`;
        }

        priceInput.addEventListener("input", updatePriceFeeNote);
        updatePriceFeeNote();

        const titleInput = document.getElementById("adTitle");
        const titleError = document.getElementById("titleError");
        const titleKeywordsList = Array.from(document.querySelectorAll("#titleKeywords option")).map((o) => o.value.toLowerCase());

        function isValidTitle() {
        return titleKeywordsList.includes(titleInput.value.trim().toLowerCase());
        }

        function validateTitle() {
        const valid = isValidTitle();
        titleError.style.display = valid ? "none" : "block";
        titleInput.setCustomValidity(valid ? "" : "Yalnız siyahıdan bir söz seçin.");
        return valid;
        }

        titleInput.addEventListener("blur", validateTitle);
        titleInput.addEventListener("input", () => {
        titleInput.setCustomValidity("");
        titleError.style.display = "none";
        });

        document.getElementById("postAdForm").addEventListener("submit", (e) => {
        if (!validateTitle()) {
        e.preventDefault();
        titleInput.focus();
        }
        });

        const categorySelect = document.getElementById("adCategory");
        const subcategorySelect = document.getElementById("adSubcategory");

        function populateSubcategories(preselect) {
        const selected = categoriesData.find((c) => String(c.id) === categorySelect.value);
        const subcats = selected?.subcategories ?? [];
        subcategorySelect.disabled = subcats.length === 0;
        subcategorySelect.innerHTML =
        `<option value="">${t("select_option")}</option>` +
        subcats.map((sub) => `<option value="${sub.id}">${localName(sub)}</option>`).join("");
        if (preselect) {
        subcategorySelect.value = String(preselect);
        }
        }

        populateSubcategories(selectedSubcategoryId);

        categorySelect.addEventListener("change", () => populateSubcategories(null));

        const MAX_IMAGES = @SandiqMVC.Models.Product.MaxImages;
        const dropzone = document.getElementById("dropzone");
        const fileInput = document.getElementById("adImages");
        const previewsEl = document.getElementById("imagePreviews");
        let selectedFiles = [];

        dropzone.addEventListener("click", () => fileInput.click());

        dropzone.addEventListener("dragover", (e) => {
        e.preventDefault();
        dropzone.classList.add("dragover");
        });

        dropzone.addEventListener("dragleave", () => {
        dropzone.classList.remove("dragover");
        });

        dropzone.addEventListener("drop", (e) => {
        e.preventDefault();
        dropzone.classList.remove("dragover");
        const imageFiles = Array.from(e.dataTransfer.files).filter((f) => f.type.startsWith("image/"));
        addFiles(imageFiles);
        });

        fileInput.addEventListener("change", () => {
        addFiles(Array.from(fileInput.files));
        });

        function addFiles(files) {
        for (const file of files) {
        if (selectedFiles.length >= MAX_IMAGES) {
        showToast(`Maksimum ${MAX_IMAGES} şəkil yükləyə bilərsiniz`);
        break;
        }
        selectedFiles.push(file);
        }
        syncFileInput();
        renderPreviews();
        }

        function syncFileInput() {
        const dataTransfer = new DataTransfer();
        selectedFiles.forEach((f) => dataTransfer.items.add(f));
        fileInput.files = dataTransfer.files;
        }

        function renderPreviews() {
        previewsEl.innerHTML = "";
        selectedFiles.forEach((file, index) => {
        const url = URL.createObjectURL(file);
        const item = document.createElement("div");
        item.className = "post-ad-preview";
        item.innerHTML = `
        <img src="${url}" alt="${file.name}" />
        <button type="button" class="post-ad-preview__remove">×</button>
        `;
        previewsEl.appendChild(item);

        item.querySelector(".post-ad-preview__remove").addEventListener("click", () => {
        selectedFiles.splice(index, 1);
        syncFileInput();
        renderPreviews();
        });
        });
        }
    </script>
}