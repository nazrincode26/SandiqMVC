@model List<SandiqMVC.Models.Category>

@{
    ViewData["Title"] = "Kateqoriyalar";
}

<div class="admin-page-header">
    <h2>Kateqoriyalar</h2>
    <button type="button" id="createCategoryBtn" class="admin-btn admin-btn--primary">+ Yeni kateqoriya</button>
</div>

<div class="category-list">
    @foreach (var category in Model)
    {
        <div class="category-card">
            <div class="category-card__row">
                <span class="category-card__name">@category.Name</span>
                <div class="category-card__actions">
                    <button type="button" class="admin-btn add-sub-btn" data-id="@category.Id" data-name="@category.Name">+ Alt kateqoriya</button>
                    <button type="button" class="admin-btn edit-category-btn" data-id="@category.Id" data-name="@category.Name" data-name-ru="@category.NameRu" data-name-en="@category.NameEn" data-icon="@category.Icon">Redaktə et</button>
                    <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline" onsubmit="return confirm('Silmək istədiyinizə əminsiniz?');">
                        <button type="submit" class="admin-btn admin-btn--danger">Sil</button>
                    </form>
                </div>
            </div>
            @if (category.Subcategories != null && category.Subcategories.Any())
            {
                <div class="category-card__subs">
                    @foreach (var sub in category.Subcategories)
                    {
                        <div class="category-card__sub-row">
                            <span>@sub.Name</span>
                            <div class="category-card__actions">
                                <button type="button" class="admin-btn edit-category-btn" data-id="@sub.Id" data-name="@sub.Name" data-name-ru="@sub.NameRu" data-name-en="@sub.NameEn" data-icon="@sub.Icon">Redaktə et</button>
                                <form asp-action="Delete" asp-route-id="@sub.Id" method="post" class="d-inline" onsubmit="return confirm('Silmək istədiyinizə əminsiniz?');">
                                    <button type="submit" class="admin-btn admin-btn--danger">Sil</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<div id="categoryModal" class="admin-modal hidden">
    <div class="admin-modal__box admin-form">
        <h2 id="modalTitle">Yeni kateqoriya</h2>
        <form id="categoryForm" method="post">
            <input type="hidden" name="Id" id="formId" value="0" />
            <input type="hidden" name="ParentId" id="formParentId" value="" />
            <label>
                Ad (AZ)
                <input type="text" name="Name" id="formName" required />
            </label>
            <label>
                Ad (RU)
                <input type="text" name="NameRu" id="formNameRu" />
            </label>
            <label>
                Ad (EN)
                <input type="text" name="NameEn" id="formNameEn" />
            </label>
            <label>
                İkon URL (istəyə bağlı)
                <input type="text" name="Icon" id="formIcon" />
            </label>
            <p id="parentInfo" class="category-form__parent-info hidden"></p>
            <div class="admin-modal__actions">
                <button type="button" id="modalCancelBtn" class="admin-btn">Ləğv et</button>
                <button type="submit" class="admin-btn admin-btn--primary">Yadda saxla</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const categoryModal = document.getElementById("categoryModal");
        const categoryForm = document.getElementById("categoryForm");
        const modalTitle = document.getElementById("modalTitle");
        const formId = document.getElementById("formId");
        const formParentId = document.getElementById("formParentId");
        const formName = document.getElementById("formName");
        const formNameRu = document.getElementById("formNameRu");
        const formNameEn = document.getElementById("formNameEn");
        const formIcon = document.getElementById("formIcon");
        const parentInfo = document.getElementById("parentInfo");

        const createUrl = "@Url.Action("Create", "Categories", new { area = "Admin" })";
        const editUrlBase = "@Url.Action("Edit", "Categories", new { area = "Admin" })";

        document.getElementById("createCategoryBtn").addEventListener("click", () => {
            modalTitle.textContent = "Yeni kateqoriya";
            formId.value = "0";
            formParentId.value = "";
            formName.value = "";
            formNameRu.value = "";
            formNameEn.value = "";
            formIcon.value = "";
            parentInfo.classList.add("hidden");
            categoryForm.action = createUrl;
            categoryModal.classList.remove("hidden");
        });

        document.querySelectorAll(".add-sub-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                modalTitle.textContent = "Yeni alt kateqoriya";
                formId.value = "0";
                formParentId.value = btn.dataset.id;
                formName.value = "";
                formNameRu.value = "";
                formNameEn.value = "";
                formIcon.value = "";
                parentInfo.textContent = `"${btn.dataset.name}" kateqoriyasının alt-kateqoriyası olaraq əlavə olunacaq.`;
                parentInfo.classList.remove("hidden");
                categoryForm.action = createUrl;
                categoryModal.classList.remove("hidden");
            });
        });

        document.querySelectorAll(".edit-category-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                modalTitle.textContent = "Kateqoriyanı redaktə et";
                formId.value = btn.dataset.id;
                formParentId.value = "";
                formName.value = btn.dataset.name;
                formNameRu.value = btn.dataset.nameRu ?? "";
                formNameEn.value = btn.dataset.nameEn ?? "";
                formIcon.value = btn.dataset.icon ?? "";
                parentInfo.classList.add("hidden");
                categoryForm.action = editUrlBase;
                categoryModal.classList.remove("hidden");
            });
        });

        document.getElementById("modalCancelBtn").addEventListener("click", () => {
            categoryModal.classList.add("hidden");
        });

        categoryModal.addEventListener("click", (e) => {
            if (e.target === categoryModal) categoryModal.classList.add("hidden");
        });
    </script>
}