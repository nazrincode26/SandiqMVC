@model SandiqMVC.Areas.Admin.ViewModels.CategoryViewModel

@{
    ViewData["Title"] = "Kateqoriyanı redaktə et";
}

<h2>Kateqoriyanı redaktə et</h2>

<form asp-action="Edit" method="post" class="col-md-4">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NameRu" class="form-label"></label>
        <input asp-for="NameRu" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="NameEn" class="form-label"></label>
        <input asp-for="NameEn" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Icon" class="form-label"></label>
        <input asp-for="Icon" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Yadda saxla</button>
    <a asp-action="Index" class="btn btn-secondary">Ləğv et</a>
</form>