@model List<SandiqMVC.Models.ListingRequest>

@{
    ViewData["Title"] = "Sorğular";
    var categories = ViewBag.Categories as List<SandiqMVC.Models.Category> ?? new List<SandiqMVC.Models.Category>();
    string CategoryName(int? id) => id.HasValue ? (categories.FirstOrDefault(c => c.Id == id.Value)?.Name ?? "-") : "-";
}

<div class="admin-page-header">
    <h2>Sorğular</h2>
</div>

<div class="pending-list">
    @if (!Model.Any())
    {
        <p>Gözləyən sorğu yoxdur.</p>
    }
    @foreach (var request in Model)
    {
        var product = request.Product;
        <div class="pending-row request-row">
            @if (!string.IsNullOrEmpty(product?.Image))
            {
                <img src="@product.Image" alt="@product.Title" />
            }
            else
            {
                <div style="width:100px;height:100px;background:var(--admin-placeholder-bg);border-radius:8px;flex-shrink:0;"></div>
            }
            <div class="pending-row__info">
                <h3>
                    @product?.Title
                    <span class="status-badge @(request.Type == "delete" ? "status--rejected" : "status--pending")">
                        @(request.Type == "delete" ? "Silmə sorğusu" : "Redaktə sorğusu")
                    </span>
                </h3>
                <p class="pending-row__meta">
                    Göndərən: @request.RequestedBy?.FullName · @request.CreatedAt.AddHours(4).ToString("dd.MM.yyyy HH:mm")
                </p>

                @if (request.Type == "edit" && product != null)
                {
                    <table class="request-diff">
                        <thead>
                            <tr><th></th><th>Cari</th><th>Təklif olunan</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>Başlıq</td><td>@product.Title</td><td>@request.Title</td></tr>
                            <tr><td>Təsvir</td><td>@product.Description</td><td>@request.Description</td></tr>
                            <tr><td>Qiymət</td><td>@product.Price.ToString("N0") ₼</td><td>@(request.Price?.ToString("N0") ?? "-") ₼</td></tr>
                            <tr><td>Kateqoriya</td><td>@product.Category?.Name</td><td>@CategoryName(request.CategoryId)</td></tr>
                            <tr><td>Vəziyyət</td><td>@product.Condition</td><td>@request.Condition</td></tr>
                            <tr><td>Yer</td><td>@product.Location</td><td>@request.Location</td></tr>
                            @if (!string.IsNullOrEmpty(request.Image))
                            {
                                <tr><td>Şəkil</td><td>-</td><td>Yeni şəkil yükləndi</td></tr>
                            }
                        </tbody>
                    </table>
                }
                else if (request.Type == "delete")
                {
                    <p class="pending-row__desc">Bu elanın silinməsi tələb olunur.</p>
                }
            </div>
            <div class="pending-row__actions">
                <form asp-action="Approve" asp-route-id="@request.Id" method="post">
                    <button type="submit" class="admin-btn admin-btn--primary">Təsdiqlə</button>
                </form>
                <form asp-action="Reject" asp-route-id="@request.Id" method="post">
                    <button type="submit" class="admin-btn admin-btn--danger">Rədd et</button>
                </form>
            </div>
        </div>
    }
</div>
