@model List<SandiqMVC.Models.PaymentCard>
@{
    ViewData["Title"] = "Ödəniş kartları";
}

<div class="admin-page-header">
    <h2>Ödəniş kartları</h2>
    <button type="button" id="createCardBtn" class="admin-btn admin-btn--primary">+ Yeni kart</button>
</div>

<p class="admin-form__hint">Bu kartlar müştərilərə checkout səhifəsində köçürmə üçün göstərilir. Platform komissiyası: @((SandiqMVC.Models.Order.PlatformFeeRate * 100).ToString("0"))%.</p>

@if (TempData["Message"] != null)
{
    <div class="admin-flash">@TempData["Message"]</div>
}

<div class="pending-list">
    @if (!Model.Any())
    {
        <p>Hələ kart əlavə edilməyib.</p>
    }
    @foreach (var card in Model)
    {
        <div class="pending-row">
            <div class="pending-row__info">
                <h3>@card.BankName <span class="status-badge @(card.IsActive ? "status--approved" : "status--rejected")">@(card.IsActive ? "Aktiv" : "Deaktiv")</span></h3>
                <p class="pending-row__desc">@card.CardNumber · @card.CardHolderName</p>
            </div>
            <div class="pending-row__actions">
                <button type="button" class="admin-btn edit-card-btn"
                        data-id="@card.Id"
                        data-bankname="@card.BankName"
                        data-cardnumber="@card.CardNumber"
                        data-cardholdername="@card.CardHolderName"
                        data-sortorder="@card.SortOrder">
                    Redaktə et
                </button>
                <form asp-action="ToggleActive" asp-route-id="@card.Id" method="post">
                    <button type="submit" class="admin-btn">@(card.IsActive ? "Deaktiv et" : "Aktiv et")</button>
                </form>
                <form asp-action="Delete" asp-route-id="@card.Id" method="post" onsubmit="return confirm('Silinsin?');">
                    <button type="submit" class="admin-btn admin-btn--danger">Sil</button>
                </form>
            </div>
        </div>
    }
</div>

<div id="cardModal" class="admin-modal hidden">
    <div class="admin-modal__box admin-form">
        <h2 id="cardModalTitle">Yeni kart</h2>

        <form id="cardForm" method="post">
            <input type="hidden" name="Id" id="cardFormId" value="0" />
            <label>
                Bank adı
                <input type="text" name="BankName" id="cardFormBank" required placeholder="Məs. Kapital Bank" />
            </label>
            <label>
                Kart nömrəsi
                <input type="text" name="CardNumber" id="cardFormNumber" required placeholder="0000 0000 0000 0000" maxlength="19" inputmode="numeric" />
            </label>
            <label>
                Kart sahibinin adı
                <input type="text" name="CardHolderName" id="cardFormHolder" required />
            </label>
            <label>
                Sıra nömrəsi
                <input type="number" name="SortOrder" id="cardFormSort" value="0" />
            </label>

            <div class="admin-modal__actions">
                <button type="button" id="cardModalCancelBtn" class="admin-btn">Ləğv et</button>
                <button type="submit" class="admin-btn admin-btn--primary">Yadda saxla</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const cardModal = document.getElementById("cardModal");
        const cardForm = document.getElementById("cardForm");
        const cardModalTitle = document.getElementById("cardModalTitle");
        const cardFormId = document.getElementById("cardFormId");
        const cardFormBank = document.getElementById("cardFormBank");
        const cardFormNumber = document.getElementById("cardFormNumber");
        const cardFormHolder = document.getElementById("cardFormHolder");
        const cardFormSort = document.getElementById("cardFormSort");

        cardFormNumber.addEventListener("input", () => {
            const digits = cardFormNumber.value.replace(/\D/g, "").slice(0, 16);
            cardFormNumber.value = digits.replace(/(.{4})/g, "$1 ").trim();
        });

        const createCardUrl = "@Url.Action("Create", "PaymentCards", new { area = "Admin" })";
        const editCardUrl = "@Url.Action("Edit", "PaymentCards", new { area = "Admin" })";

        document.getElementById("createCardBtn").addEventListener("click", () => {
            cardModalTitle.textContent = "Yeni kart";
            cardFormId.value = "0";
            cardFormBank.value = "";
            cardFormNumber.value = "";
            cardFormHolder.value = "";
            cardFormSort.value = "0";
            cardForm.action = createCardUrl;
            cardModal.classList.remove("hidden");
        });

        document.querySelectorAll(".edit-card-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                cardModalTitle.textContent = "Kartı redaktə et";
                cardFormId.value = btn.dataset.id;
                cardFormBank.value = btn.dataset.bankname;
                cardFormNumber.value = btn.dataset.cardnumber;
                cardFormHolder.value = btn.dataset.cardholdername;
                cardFormSort.value = btn.dataset.sortorder;
                cardForm.action = editCardUrl;
                cardModal.classList.remove("hidden");
            });
        });

        document.getElementById("cardModalCancelBtn").addEventListener("click", () => {
            cardModal.classList.add("hidden");
        });

        cardModal.addEventListener("click", (e) => {
            if (e.target === cardModal) cardModal.classList.add("hidden");
        });
    </script>
}
