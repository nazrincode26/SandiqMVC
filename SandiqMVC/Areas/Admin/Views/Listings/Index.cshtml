@model List<SandiqMVC.Models.Product>

@{
    ViewData["Title"] = "Gözləyən elanlar";
}

<h2>Gözləyən elanlar</h2>

<div class="pending-list">
    @if (!Model.Any())
    {
        <p>Gözləyən elan yoxdur.</p>
    }
    @foreach (var product in Model)
    {
        <div class="pending-row">
            <div style="width:100px;height:100px;background:#EFE6D6;border-radius:8px;flex-shrink:0;"></div>
            <div class="pending-row__info">
                <h3>@product.Title</h3>
                <p class="pending-row__desc">@product.Description</p>
                <p class="pending-row__meta">@product.Price.ToString("N0") ₼ · @product.Category?.Name · Göndərən: @product.SubmittedBy?.FullName</p>
            </div>
            <div class="pending-row__actions">
                <form asp-action="Approve" asp-route-id="@product.Id" method="post">
                    <button type="submit" class="admin-btn admin-btn--primary">Təsdiqlə</button>
                </form>
                <form asp-action="Reject" asp-route-id="@product.Id" method="post">
                    <button type="submit" class="admin-btn admin-btn--danger">Rədd et</button>
                </form>
            </div>
        </div>
    }
</div>