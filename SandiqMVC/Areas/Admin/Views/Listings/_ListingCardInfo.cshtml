@model SandiqMVC.Areas.Admin.ViewModels.ListingCardViewModel
@{
    var product = Model.Product;
}

@if (!string.IsNullOrEmpty(product.Image))
{
    <img src="@product.Image" alt="@product.Title" style="width:100px;height:100px;border-radius:8px;flex-shrink:0;object-fit:cover;" />
}
else
{
    <div style="width:100px;height:100px;background:var(--admin-placeholder-bg);border-radius:8px;flex-shrink:0;"></div>
}
<div class="pending-row__info">
    <h3>@product.Title</h3>
    <p class="pending-row__desc">@product.Description</p>
    <p class="pending-row__meta">
        @product.Price.ToString("N0") ₼ · @product.Category?.Name@(Model.ShowSeller ? $" · Göndərən: {product.SubmittedBy?.FullName}" : "")
    </p>
    @if (!string.IsNullOrEmpty(Model.StatusLabel))
    {
        <span class="status-badge">@Model.StatusLabel</span>
    }
</div>