@model List<SandiqMVC.Models.Product>

@{
    ViewData["Title"] = "Bütün elanlar";
    var categories = ViewBag.Categories as List<SandiqMVC.Models.Category>;
    var currentFilter = ViewBag.CurrentFilter as string;
}

<div class="admin-page-header">
    <h2>Bütün elanlar</h2>
    <button type="button" id="createBtn" class="admin-btn admin-btn--primary">+ Yeni elan</button>
</div>

<div class="admin-filter-tabs">
    <a asp-action="AllListings" asp-route-filter="all" class="admin-filter-tab @(currentFilter == "all" ? "active" : "")">Hamısı</a>
    <a asp-action="AllListings" asp-route-filter="active" class="admin-filter-tab @(currentFilter == "active" ? "active" : "")">Aktiv</a>
    <a asp-action="AllListings" asp-route-filter="deleted" class="admin-filter-tab @(currentFilter == "deleted" ? "active" : "")">Silinmiş (soft)</a>
</div>

<div class="pending-list">
    @if (!Model.Any())
    {
        <p>Elan yoxdur.</p>
    }
    @foreach (var product in Model)
    {
        var statusLabel = product.Status switch
        {
            "approved" => "Təsdiqləndi",
            "rejected" => "Rədd edildi",
            "deleted" => "Silinib",
            _ => "Gözləyir"
        };

        <div class="pending-row">
            <partial name="_ListingCardInfo" model="new SandiqMVC.Areas.Admin.ViewModels.ListingCardViewModel { Product = product, StatusLabel = statusLabel }" />
            <div class="pending-row__actions">
                <button type="button" class="admin-btn edit-listing-btn"
                        data-id="@product.Id"
                        data-title="@product.Title"
                        data-description="@product.Description"
                        data-price="@product.Price"
                        data-categoryid="@product.CategoryId"
                        data-subcategoryid="@product.SubcategoryId"
                        data-condition="@product.Condition"
                        data-location="@product.Location"
                        data-images="@System.Text.Json.JsonSerializer.Serialize(product.Images.Any() ? product.Images.OrderBy(i => i.SortOrder).Select(i => i.Path) : (!string.IsNullOrEmpty(product.Image) ? new[] { product.Image } : Array.Empty<string>()))">
                    Redaktə et
                </button>

                @if (product.Status == "deleted")
                {
                    <form asp-action="Restore" asp-route-id="@product.Id" method="post">
                        <button type="submit" class="admin-btn admin-btn--primary">Bərpa et</button>
                    </form>
                }
                else
                {
                    <form asp-action="SoftDelete" asp-route-id="@product.Id" method="post">
                        <button type="submit" class="admin-btn">Sil (soft)</button>
                    </form>
                }
                <form asp-action="HardDelete" asp-route-id="@product.Id" method="post" onsubmit="return confirm('Tam silmək istədiyinizə əminsiniz? Bu geri qaytarıla bilməz.');">
                    <button type="submit" class="admin-btn admin-btn--danger">Tam sil</button>
                </form>
            </div>
        </div>
    }
</div>

<div id="listingModal" class="admin-modal hidden">
    <div class="admin-modal__box admin-form">
        <h2 id="modalTitle">Yeni elan</h2>
        <p class="admin-form__subtitle">Elan məlumatlarını doldurun</p>

        <form id="listingForm" method="post" enctype="multipart/form-data">
            <input type="hidden" name="Id" id="formId" value="0" />
            <section class="admin-form__section">
                <h3 class="admin-form__section-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
                    Əsas məlumat
                </h3>
                <label>
                    Başlıq
                    <input type="text" name="Title" id="formTitle" required />
                </label>
                <label>
                    Təsvir
                    <textarea name="Description" id="formDescription" rows="4"></textarea>
                </label>
            </section>

            <section class="admin-form__section">
                <h3 class="admin-form__section-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect></svg>
                    Kateqoriya və qiymət
                </h3>
                <div class="admin-form__grid">
                    <label>
                        Kateqoriya
                        <select name="CategoryId" id="formCategory" required>
                            <option value="">Seçin...</option>
                            @foreach (var category in categories!)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                    </label>
                    <label>
                        Alt kateqoriya
                        <select name="SubcategoryId" id="formSubcategory" disabled>
                            <option value="">Əvvəlcə kateqoriya seçin</option>
                        </select>
                    </label>
                    <label>
                        Qiymət (₼)
                        <input type="text" inputmode="decimal" name="Price" id="formPrice" oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1')" required />
                    </label>
                    <label>
                        Vəziyyəti
                        <select name="Condition" id="formCondition">
                            <option value="new">Yeni</option>
                            <option value="used">İşlənmiş</option>
                        </select>
                    </label>
                    <label class="admin-form__full">
                        Yerləşdiyi yer
                        <input type="text" name="Location" id="formLocation" list="azRegions" autocomplete="off" placeholder="Məs. Bakı, Nəsimi" />
                        <partial name="_AzRegionsDatalist" />
                    </label>
                </div>
            </section>

            <section class="admin-form__section">
                <h3 class="admin-form__section-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg>
                    Şəkillər (maksimum @SandiqMVC.Models.Product.MaxImages ədəd)
                </h3>
                <p class="admin-form__hint" id="modalImageHint">Yeni şəkil seçsəniz, mövcud şəkillərin yerinə keçəcək.</p>
                <input type="file" name="ImageFiles" id="formImages" accept="image/*" multiple />
                <div class="post-ad-previews" id="modalImagePreviews"></div>
            </section>

            <div class="admin-modal__actions">
                <button type="button" id="modalCancelBtn" class="admin-btn">Ləğv et</button>
                <button type="submit" class="admin-btn admin-btn--primary">Yadda saxla</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const categoriesData = @Json.Serialize(categories!.Select(c => new { id = c.Id, name = c.Name, subcategories = c.Subcategories.Select(s => new { id = s.Id, name = s.Name }) }));

        const listingModal = document.getElementById("listingModal");
        const listingForm = document.getElementById("listingForm");
        const modalTitle = document.getElementById("modalTitle");
        const formId = document.getElementById("formId");
        const formTitle = document.getElementById("formTitle");
        const formDescription = document.getElementById("formDescription");
        const formCategory = document.getElementById("formCategory");
        const formSubcategory = document.getElementById("formSubcategory");
        const formPrice = document.getElementById("formPrice");
        const formCondition = document.getElementById("formCondition");
        const formLocation = document.getElementById("formLocation");
        const formImages = document.getElementById("formImages");
        const modalImagePreviews = document.getElementById("modalImagePreviews");
        const modalImageHint = document.getElementById("modalImageHint");
        const MAX_IMAGES = @SandiqMVC.Models.Product.MaxImages;
        let selectedImageFiles = [];

        function syncFormImages() {
            const dataTransfer = new DataTransfer();
            selectedImageFiles.forEach((f) => dataTransfer.items.add(f));
            formImages.files = dataTransfer.files;
        }

        function renderModalPreviews() {
            modalImagePreviews.innerHTML = "";
            selectedImageFiles.forEach((file, index) => {
                const url = URL.createObjectURL(file);
                const item = document.createElement("div");
                item.className = "post-ad-preview";
                item.innerHTML = `<img src="${url}" alt="${file.name}" /><button type="button" class="post-ad-preview__remove">×</button>`;
                modalImagePreviews.appendChild(item);
                item.querySelector(".post-ad-preview__remove").addEventListener("click", () => {
                    selectedImageFiles.splice(index, 1);
                    syncFormImages();
                    renderModalPreviews();
                });
            });
        }

        formImages.addEventListener("change", () => {
            for (const file of Array.from(formImages.files)) {
                if (selectedImageFiles.length >= MAX_IMAGES) break;
                selectedImageFiles.push(file);
            }
            syncFormImages();
            renderModalPreviews();
        });

        const createUrl = "@Url.Action("CreateAdmin", "Listings", new { area = "Admin" })";
        const editUrl = "@Url.Action("EditAdmin", "Listings", new { area = "Admin" })";

        function populateSubcategories(categoryId, selectedSubcategoryId) {
            const category = categoriesData.find((c) => String(c.id) === String(categoryId));
            const subcats = category?.subcategories ?? [];
            formSubcategory.disabled = subcats.length === 0;
            formSubcategory.innerHTML =
                `<option value="">Seçin...</option>` +
                subcats.map((sub) => `<option value="${sub.id}">${sub.name}</option>`).join("");
            if (selectedSubcategoryId) {
                formSubcategory.value = selectedSubcategoryId;
            }
        }

        formCategory.addEventListener("change", () => populateSubcategories(formCategory.value, null));

        document.getElementById("createBtn").addEventListener("click", () => {
            modalTitle.textContent = "Yeni elan";
            formId.value = "0";
            formTitle.value = "";
            formDescription.value = "";
            formCategory.value = "";
            formSubcategory.innerHTML = `<option value="">Əvvəlcə kateqoriya seçin</option>`;
            formSubcategory.disabled = true;
            formPrice.value = "";
            formCondition.value = "used";
            formLocation.value = "";
            selectedImageFiles = [];
            syncFormImages();
            renderModalPreviews();
            modalImageHint.textContent = "";
            listingForm.action = createUrl;
            listingModal.classList.remove("hidden");
        });

        document.querySelectorAll(".edit-listing-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                modalTitle.textContent = "Elanı redaktə et";
                formId.value = btn.dataset.id;
                formTitle.value = btn.dataset.title;
                formDescription.value = btn.dataset.description ?? "";
                formCategory.value = btn.dataset.categoryid;
                populateSubcategories(btn.dataset.categoryid, btn.dataset.subcategoryid);
                formPrice.value = btn.dataset.price;
                formCondition.value = btn.dataset.condition ?? "used";
                formLocation.value = btn.dataset.location ?? "";
                selectedImageFiles = [];
                syncFormImages();
                renderModalPreviews();
                const existingImages = JSON.parse(btn.dataset.images || "[]");
                modalImagePreviews.innerHTML = existingImages
                    .map((src) => `<div class="post-ad-preview"><img src="${src}" alt="" /></div>`)
                    .join("");
                modalImageHint.textContent = existingImages.length
                    ? `Hazırda ${existingImages.length} şəkil var. Yeni şəkil seçsəniz, bunların yerinə keçəcək.`
                    : "";
                listingForm.action = editUrl;
                listingModal.classList.remove("hidden");
            });
        });

        document.getElementById("modalCancelBtn").addEventListener("click", () => {
            listingModal.classList.add("hidden");
        });

        listingModal.addEventListener("click", (e) => {
            if (e.target === listingModal) listingModal.classList.add("hidden");
        });
    </script>
}