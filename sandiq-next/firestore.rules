rules_version = '2';

// All Firestore access goes through the Next.js server with the Admin SDK,
// which bypasses these rules. Browsers never read or write Firestore directly,
// so every client request is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
