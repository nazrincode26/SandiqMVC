{
  "name": "sandiq-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --test tests/*.test.ts",
    "verify:cloudinary": "node --conditions=react-server --env-file-if-exists=.env.local scripts/verify-cloudinary.ts",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "set-admin": "node --env-file-if-exists=.env.local scripts/set-admin.ts",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate-from-sql.ts",
    "emulators": "firebase emulators:start --project demo-sandiq"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "next": "^16.4.3",
    "nodemailer": "^10.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
